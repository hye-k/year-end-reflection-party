# Copy to .env.local and fill in the deployed Apps Script web app URL (ends with /exec).
# When unset, the app runs offline: drafts stay in localStorage and server calls report "not-configured".
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# The deployed address of the site, without a trailing slash. It makes link previews (KakaoTalk, messengers) show
# the picture in public/og.png; leave it unset for local work.
VITE_SITE_URL=https://REPLACE_WITH_SITE_ADDRESS
